# Copy to .env for local testing. Never commit .env or API keys to GitHub.
# Required for the hackathon AI feature: Nebius Token Factory + NVIDIA Nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/chat/completions
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_TIMEOUT=45

# Optional legacy Ring integration. Use only with authorized credentials.
RING_ACCESS_TOKEN=
RING_API_BASE_URL=https://api.amazonvision.com

# Optional legacy Amazon Bedrock fallback; configure AWS credentials separately.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
